{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^Bagua(.*)": "@/components/Bagua$1/index.vue",
      "^Traditional(.*)": "@/components/Traditional$1/index.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "文墨天机",
        "navigationBarBackgroundColor": "#1a1a2e",
        "navigationBarTextStyle": "white",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/bazi/input",
      "style": {
        "navigationBarTitleText": "八字排盘",
        "navigationBarBackgroundColor": "#1a1a2e",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/bazi/result",
      "style": {
        "navigationBarTitleText": "命盘分析",
        "navigationBarBackgroundColor": "#1a1a2e",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/liuyao/divination",
      "style": {
        "navigationBarTitleText": "六爻占卜",
        "navigationBarBackgroundColor": "#1a1a2e",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/liuyao/result",
      "style": {
        "navigationBarTitleText": "卦象解析",
        "navigationBarBackgroundColor": "#1a1a2e",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "个人中心",
        "navigationBarBackgroundColor": "#1a1a2e",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/history/index",
      "style": {
        "navigationBarTitleText": "测算历史",
        "navigationBarBackgroundColor": "#1a1a2e",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/feedback/index",
      "style": {
        "navigationBarTitleText": "反馈评价",
        "navigationBarBackgroundColor": "#1a1a2e",
        "navigationBarTextStyle": "white"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "文墨天机",
    "navigationBarBackgroundColor": "#1a1a2e",
    "backgroundColor": "#f5f0e8",
    "app-plus": {
      "background": "#f5f0e8"
    }
  },
  "tabBar": {
    "color": "#666666",
    "selectedColor": "#c9a96e",
    "backgroundColor": "#f5f0e8",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/history/index",
        "text": "历史",
        "iconPath": "static/tabbar/history.png",
        "selectedIconPath": "static/tabbar/history-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  },
  "condition": {}
}
